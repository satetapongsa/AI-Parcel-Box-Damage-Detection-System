# ===== SPDI bridge config =====
# copy this file to bridge/.env and fill in. NEVER commit .env

# MQTT broker (Mosquitto on this laptop)
MQTT_URL=mqtt://127.0.0.1:1883

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Use a *Database User* password. URL-encode special chars (@ -> %40, : -> %3A ...)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=spdi

# Production line id -> topics spdi/<LINE_ID>/detections|events|counted
LINE_ID=line1

# Class names EXACTLY as your CiRA model outputs them (comma separated, case-insensitive)
GOOD_CLASSES=box_good,box,good,good_box,o
DAMAGED_CLASSES=dent,tear,x,bad,box_damaged,damaged,damaged_box,damage,defect,broken,crushed,torn

# Ignore detections below this confidence (0-1)
MIN_CONF=0.5

# Video/camera resolution used by CiRA (only matters if CiRA sends pixel coordinates)
FRAME_W=640
FRAME_H=480
# Meaning of x,y from CiRA: center | topleft
BOX_ORIGIN=center

# Virtual counting line (0 = left edge, 1 = right edge) and travel direction ltr | rtl
LINE_POS=0.5
DIRECTION=ltr

# Tracking: max jump between frames (normalized), forget a box after this many ms
MAX_DIST=0.12
TRACK_TTL_MS=1000
# A box must be seen at least this many frames before it can be counted
MIN_FRAMES=5
# FAIL if (damaged frames / all frames) >= FAIL_RATIO   (lower = stricter)
FAIL_RATIO=0.3

# Input type: video = boxes move across the virtual line (VideoFile / camera)
#             still = a box is placed or held in view, counted once it is seen steadily
#             image = one still picture = one box (CiRA Image Slide)
# The Control Center can switch this without editing the file.
INPUT_MODE=video

# ESP32 simulator (Wokwi) relay: npm run relay
# Public broker the Wokwi ESP32 can reach (Wokwi runs in the cloud, it cannot see 127.0.0.1)
RELAY_URL=mqtt://broker.hivemq.com:1883
# Leave empty: the first `npm run relay` creates a random one and saves it here
RELAY_TOPIC=

# Where counted boxes go:
#   mongo = straight to MongoDB Atlas (needs port 27017 open on your network)
#   http  = POST to the dashboard /api/ingest over HTTPS (works where 27017 is blocked)
SINK=mongo
# for SINK=http: your dashboard URL and the same INGEST_TOKEN as on the dashboard (Vercel env)
INGEST_URL=https://<your-dashboard>.vercel.app
INGEST_TOKEN=

# Queue kept on disk while the database cannot be reached (survives a restart)
OUTBOX_FILE=data/outbox.jsonl
OUTBOX_MAX=20000

# Optional alerts (leave empty = off)
#   Discord: Server Settings -> Integrations -> Webhooks -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
#   LINE Messaging API: channel access token + your user / group ID
LINE_CHANNEL_TOKEN=
LINE_TO=
ALERT_FAIL_STREAK=3
ALERT_OFFLINE_S=60
ALERT_COOLDOWN_S=60
