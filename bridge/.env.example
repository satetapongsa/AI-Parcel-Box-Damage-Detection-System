# ===== SPDI bridge config =====
# copy this file to bridge/.env and fill in. NEVER commit .env

# MQTT broker (Mosquitto on this laptop)
MQTT_URL=mqtt://127.0.0.1:1883

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
# Use a *Database User* password. URL-encode special chars (@ -> %40, : -> %3A ...)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=spdi

# Production line id -> topics spdi/<LINE_ID>/detections|events|counted
LINE_ID=line1

# Class names EXACTLY as your CiRA model outputs them (comma separated, case-insensitive)
GOOD_CLASSES=good,good_box,normal,ok,pass
DAMAGED_CLASSES=damaged,damaged_box,damage,defect,broken,ng,fail

# Ignore detections below this confidence (0-1)
MIN_CONF=0.5

# Video/camera resolution used by CiRA (only matters if CiRA sends pixel coordinates)
FRAME_W=640
FRAME_H=480
# Meaning of x,y from CiRA: center | topleft
BOX_ORIGIN=center

# Virtual counting line (0 = left edge, 1 = right edge) and travel direction ltr | rtl
LINE_POS=0.5
DIRECTION=ltr

# Tracking: max jump between frames (normalized), forget a box after this many ms
MAX_DIST=0.12
TRACK_TTL_MS=1000
# A box must be seen at least this many frames before it can be counted
MIN_FRAMES=5
# FAIL if (damaged frames / all frames) >= FAIL_RATIO   (lower = stricter)
FAIL_RATIO=0.3
