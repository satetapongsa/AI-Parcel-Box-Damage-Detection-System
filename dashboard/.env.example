# copy to dashboard/.env.local (local dev) or set in Vercel -> Project -> Settings -> Environment Variables
# NEVER prefix these with NEXT_PUBLIC_ (that would leak them to the browser)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=spdi

# Optional: enables POST /api/reset with header "x-admin-token: <ADMIN_TOKEN>".
# Leave empty to keep reset disabled (403). Use a long random string.
ADMIN_TOKEN=

# Optional: lets the bridge send inspections over HTTPS (bridge SINK=http) to POST /api/ingest.
# Same value as INGEST_TOKEN in bridge/.env. At least 24 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to keep /api/ingest disabled (403).
INGEST_TOKEN=

# Optional: password for the Live page and its data APIs. Leave both empty = no login (public).
# Make both values with:  node tools/hash-password.mjs
DASHBOARD_PASSWORD_HASH=
SESSION_SECRET=
