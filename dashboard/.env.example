# copy to dashboard/.env.local (local dev) or set in Vercel -> Project -> Settings -> Environment Variables
# NEVER prefix these with NEXT_PUBLIC_ (that would leak them to the browser)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=spdi

# Optional: enables POST /api/reset with header "x-admin-token: <ADMIN_TOKEN>".
# Leave empty to keep reset disabled (403). Use a long random string.
ADMIN_TOKEN=
