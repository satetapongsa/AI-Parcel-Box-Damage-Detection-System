{
  "version": 1,
  "author": "satetapongsa",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": -150, "left": 30, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-lcd1602", "id": "lcd", "top": -170, "left": -340, "attrs": { "pins": "i2c" } },

    { "type": "wokwi-led", "id": "led_red", "top": -170, "left": 230, "attrs": { "color": "red", "label": "REJECT" } },
    { "type": "wokwi-led", "id": "led_yellow", "top": -125, "left": 230, "attrs": { "color": "yellow", "label": "WAIT" } },
    { "type": "wokwi-led", "id": "led_green", "top": -80, "left": 230, "attrs": { "color": "green", "label": "RUN" } },

    { "type": "wokwi-servo", "id": "servo_dent", "top": 20, "left": 220, "attrs": { "horn": "single", "hornColor": "#1e88e5" } },
    { "type": "wokwi-led", "id": "led_bin_dent", "top": 20, "left": 400, "attrs": { "color": "blue", "label": "DENT BIN" } },
    { "type": "wokwi-servo", "id": "servo_tear", "top": 120, "left": 220, "attrs": { "horn": "single", "hornColor": "#fb8c00" } },
