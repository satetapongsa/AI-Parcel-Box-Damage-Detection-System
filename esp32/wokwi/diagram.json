    { "type": "wokwi-buzzer", "id": "buzzer", "top": 230, "left": 260, "attrs": { "volume": "0.2" } },
    { "type": "wokwi-pushbutton", "id": "btn", "top": 240, "left": -170, "attrs": { "color": "red", "label": "TEST FAIL" } }
