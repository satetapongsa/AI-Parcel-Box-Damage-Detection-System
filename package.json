{
  "name": "spdi",
  "version": "1.0.0",
  "private": true,
  "description": "SPDI - Smart Parcel Damage Inspector (CiRA CORE -> MQTT -> Bridge -> MongoDB -> Next.js)",
  "scripts": {
    "setup": "npm install && npm --prefix bridge install && npm --prefix dashboard install",
    "broker": "mosquitto -c broker/mosquitto.conf -v",
    "broker:node": "npm --prefix bridge run broker",
    "bridge": "npm --prefix bridge start",
    "bridge:nodb": "npm --prefix bridge run start:nodb",
    "sim": "npm --prefix bridge run sim",
    "sim:events": "npm --prefix bridge run sim:events",
    "sniff": "npm --prefix bridge run sniff",
    "relay": "npm --prefix bridge run relay",
    "relay:test": "npm --prefix bridge run relay:test",
    "reset": "npm --prefix bridge run reset",
    "dashboard": "npm --prefix dashboard run dev",
    "demo:sim": "concurrently -k -n bridge,sim,dash -c green,yellow,cyan \"npm:bridge\" \"npm:sim\" \"npm:dashboard\"",
    "demo:sim:nobroker": "concurrently -k -n broker,bridge,sim,dash -c magenta,green,yellow,cyan \"npm:broker:node\" \"npm:bridge\" \"npm:sim\" \"npm:dashboard\"",
    "demo:cira": "concurrently -k -n bridge,dash -c green,cyan \"npm:bridge\" \"npm:dashboard\"",
    "demo:cira:nobroker": "concurrently -k -n broker,bridge,dash -c magenta,green,cyan \"npm:broker:node\" \"npm:bridge\" \"npm:dashboard\"",
    "all": "concurrently -k -n broker,bridge,sim,dash,esp32 -c magenta,green,yellow,cyan,blue \"npm:broker:node\" \"npm:bridge\" \"npm:sim\" \"npm:dashboard\" \"npm:relay\"",
    "all:cira": "concurrently -k -n broker,bridge,dash,esp32 -c magenta,green,cyan,blue \"npm:broker:node\" \"npm:bridge\" \"npm:dashboard\" \"npm:relay\"",
    "setup:env": "node tools/setup-env.js",
    "test": "npm --prefix bridge test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
