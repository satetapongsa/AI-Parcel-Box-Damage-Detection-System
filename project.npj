            "data": "{\n    \"connections\": [\n        {\n            \"in_id\": \"{d48b5586-5545-40ed-924a-897999d7ad63}\",\n            \"in_index\": 0,\n            \"out_id\": \"{d6e1ebfc-03a4-4936-ab39-982bba7ef7c3}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{3ca2e854-5fa5-491d-8555-e52ea665b4bc}\",\n            \"in_index\": 0,\n            \"out_id\": \"{30107835-44d1-4060-a06a-fe8588d2daf8}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{3b357752-d9c6-49b7-b55a-2433283f2f33}\",\n            \"in_index\": 0,\n            \"out_id\": \"{46c82637-d182-4e20-ac3c-716072314d60}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{d6e1ebfc-03a4-4936-ab39-982bba7ef7c3}\",\n            \"in_index\": 0,\n            \"out_id\": \"{d48b5586-5545-40ed-924a-897999d7ad63}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{46c82637-d182-4e20-ac3c-716072314d60}\",\n            \"in_index\": 0,\n            \"out_id\": \"{d48b5586-5545-40ed-924a-897999d7ad63}\",\n            \"out_index\": 0\n        },\n        {\n            \"in_id\": \"{30107835-44d1-4060-a06a-fe8588d2daf8}\",\n            \"in_index\": 0,\n            \"out_id\": \"{46c82637-d182-4e20-ac3c-716072314d60}\",\n            \"out_index\": 0\n        }\n    ],\n    \"nodes\": [\n        {\n            \"id\": \"{46c82637-d182-4e20-ac3c-716072314d60}\",\n            \"model\": {\n                \"data\": {\n                    \"curr_tap\": 0,\n                    \"draw_roi\": true,\n                    \"enable_tracking\": false,\n                    \"font_scale\": 1.2,\n                    \"font_thickness\": 2,\n                    \"frame_buffer\": 5,\n                    \"is_roi_polygon\": false,\n                    \"map_det_cfgs\": [\n                        {\n                            \"backend_name\": \"CUDA\",\n                            \"config_name\": \"v5\",\n                            \"config_path\": \"C:/Users/PC/Downloads/v5\"\n                        }\n                    ],\n                    \"max_dist\": 150,\n                    \"nms\": 0.3,\n                    \"rect_thickness\": 2,\n                    \"result_drawing\": true,\n                    \"roi_h\": 50000,\n                    \"roi_polygon\": {\n                    },\n                    \"roi_w\": 50000,\n                    \"roi_x\": 0,\n                    \"roi_y\": 0,\n                    \"show_confidence\": true,\n                    \"text_drawing\": true,\n                    \"this_config_name\": \"v5\",\n                    \"thresh\": 50,\n                    \"txt_offset\": 5\n                },\n                \"name\": \"DeepDetect \",\n                \"node_enable\": true,\n                \"obj_colors\": {\n                    \"array\": [\n                    ]\n                }\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 459,\n                \"y\": 221\n            }\n        },\n        {\n            \"id\": \"{d6e1ebfc-03a4-4936-ab39-982bba7ef7c3}\",\n            \"model\": {\n                \"name\": \"AutoRun\",\n                \"node_enable\": false\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 170,\n                \"y\": 170\n            }\n        },\n        {\n            \"id\": \"{3b357752-d9c6-49b7-b55a-2433283f2f33}\",\n            \"model\": {\n                \"height\": 417,\n                \"name\": \"Debug\",\n                \"output_h\": 0,\n                \"output_v\": 0,\n                \"page_index\": 2,\n                \"payload_h\": 0,\n                \"payload_v\": 0,\n                \"width\": 692\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 629,\n                \"y\": 289\n            }\n        },\n        {\n            \"id\": \"{30107835-44d1-4060-a06a-fe8588d2daf8}\",\n            \"model\": {\n                \"data\": {\n                    \"console\": \"\",\n                    \"js_code\": \"// ============================================================\\n// SPDI - code for CiRA CORE \\\"JavaScript\\\" node\\n// Flow: ButtonRun -> VideoFile -> DeepDetect -> Debug -> [THIS NODE] -> MqttPub\\n//\\n// Input : `payload` coming from the DeepDetect node\\n// Output: `payload` = { type:\\\"frame\\\", device:\\\"cira-01\\\", ts, objects:[{name,conf,x,y,w,h}] }\\n//\\n// ES5 only (var, for loops) - CiRA's JS engine may not support let/const/arrow functions.\\n// ============================================================\\n\\n// 1) Pick the detection result.\\n//    GPU version uses payload.DeepDetect ; CPU version uses payload.DeepDetectCPU.\\n//    To force CPU, change the line below to:  var dd = payload.DeepDetectCPU;\\nvar dd = payload.DeepDetect;\\n\\n// Automatic fallback: if DeepDetect is missing, try DeepDetectCPU.\\nif (!dd && payload.DeepDetectCPU) {\\n  dd = payload.DeepDetectCPU;\\n}\\n\\nvar objs = (dd && dd.objects) ? dd.objects : [];\\nvar out = [];\\n\\n// Image size reported by DeepDetect (e.g. 1920 x 1080). Used to convert\\n// pixel coordinates to 0-1, so the bridge does not need FRAME_W / FRAME_H.\\nvar imW = (dd && dd.im_w) ? Number(dd.im_w) : 0;\\nvar imH = (dd && dd.im_h) ? Number(dd.im_h) : 0;\\n\\n// 2) Map every detection to a small, stable shape.\\nfor (var i = 0; i < objs.length; i++) {\\n  var o = objs[i];\\n  var name = o.name;\\n  if (name === undefined || name === null) { name = o.label; }\\n  if (name === undefined || name === null) { name = o[\\\"class\\\"]; }\\n\\n  var conf = o.confidence;\\n  if (conf === undefined || conf === null) { conf = o.conf; }\\n  if (conf === undefined || conf === null) { conf = o.score; }\\n  if (conf === undefined || conf === null) { conf = 1; }\\n\\n  var w = (o.w !== undefined) ? o.w : o.width;\\n  var h = (o.h !== undefined) ? o.h : o.height;\\n\\n  var x = Number(o.x);\\n  var y = Number(o.y);\\n  w = Number(w);\\n  h = Number(h);\\n  if (imW > 0 && imH > 0) {\\n\\tx = x / imW;\\n\\ty = y / imH;\\n\\tw = w / imW;\\n\\th = h / imH;\\n  }\\n\\n  out.push({\\n\\tname: String(name),\\n\\tconf: Number(conf),\\n\\tx: x,\\n\\ty: y,\\n\\tw: w,\\n\\th: h\\n  });\\n}\\n\\n// 3) Replace payload with the message the MqttPub node will send.\\n//    The bridge counts each box once, so sending every frame is fine.\\npayload = {\\n  type: \\\"frame\\\",\\n  device: \\\"cira-01\\\",\\n  ts: new Date().getTime(),\\n  objects: out\\n};\",\n                    \"widget_state\": {\n                        \"editor_setting\": {\n                            \"autoComplete\": {\n                                \"caseSensitivity\": true,\n                                \"enable\": true,\n                                \"threshold\": 3\n                            },\n                            \"indent\": {\n                                \"enable\": true\n                            },\n                            \"theme\": \"Material Dark\",\n                            \"whitespace\": {\n                                \"enable\": false,\n                                \"size\": 2\n                            }\n                        }\n                    }\n                },\n                \"name\": \"JavaScript\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 578,\n                \"y\": 85\n            }\n        },\n        {\n            \"id\": \"{d48b5586-5545-40ed-924a-897999d7ad63}\",\n            \"model\": {\n                \"data\": {\n                    \"filename\": \"C:/Users/PC/Desktop/spdi/conveyor_good.mp4\",\n                    \"height\": 275,\n                    \"loop\": true,\n                    \"width\": 284\n                },\n                \"name\": \"VideoFile\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 323,\n                \"y\": 187\n            }\n        },\n        {\n            \"id\": \"{3ca2e854-5fa5-491d-8555-e52ea665b4bc}\",\n            \"model\": {\n                \"mqtt_pub\": {\n                    \"cert_file\": \"-\",\n                    \"host\": \"127.0.0.1\",\n                    \"is_use_cert\": false,\n                    \"is_use_ssl\": false,\n                    \"pass\": \"\",\n                    \"port\": 1883,\n                    \"qos\": 0,\n                    \"send_img\": false,\n                    \"topic\": \"spdi/line1/detections\",\n                    \"user\": \"\"\n                },\n                \"name\": \"MqttPub\",\n                \"node_enable\": true\n            },\n            \"ngo\": {\n                \"comment\": {\n                    \"data\": \"\",\n                    \"show\": false\n                }\n            },\n            \"position\": {\n                \"fix\": false,\n                \"x\": 731,\n                \"