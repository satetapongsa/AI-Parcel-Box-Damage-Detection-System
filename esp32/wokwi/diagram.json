  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "oled:SDA", "esp:21", "green", [] ],
    [ "oled:SCL", "esp:22", "blue", [] ],
    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "lcd:SDA", "esp:21", "green", [] ],
    [ "lcd:SCL", "esp:22", "blue", [] ],
    [ "lcd:VCC", "esp:5V", "red", [] ],
    [ "lcd:GND", "esp:GND.1", "black", [] ],

    [ "led_red:A", "esp:27", "red", [] ],
    [ "led_red:C", "esp:GND.2", "black", [] ],
    [ "led_yellow:A", "esp:26", "gold", [] ],
    [ "led_yellow:C", "esp:GND.2", "black", [] ],
    [ "led_green:A", "esp:25", "green", [] ],
    [ "led_green:C", "esp:GND.2", "black", [] ],

    [ "servo_dent:PWM", "esp:18", "orange", [] ],
    [ "servo_dent:V+", "esp:5V", "red", [] ],
    [ "servo_dent:GND", "esp:GND.3", "black", [] ],
    [ "led_bin_dent:A", "esp:32", "blue", [] ],
    [ "led_bin_dent:C", "esp:GND.3", "black", [] ],

    [ "servo_tear:PWM", "esp:13", "orange", [] ],
    [ "servo_tear:V+", "esp:5V", "red", [] ],
    [ "servo_tear:GND", "esp:GND.3", "black", [] ],
    [ "led_bin_tear:A", "esp:33", "orange", [] ],
    [ "led_bin_tear:C", "esp:GND.3", "black", [] ],

    [ "buzzer:2", "esp:19", "purple", [] ],
    [ "buzzer:1", "esp:GND.3", "black", [] ],

    [ "btn:1.l", "esp:4", "blue", [] ],
    [ "btn:2.l", "esp:GND.1", "black", [] ]
